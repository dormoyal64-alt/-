{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "server/**/*.js",
    "scripts/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "scripts/demo/**",
    "scripts/sim/**",
    "scripts/android/**"
  ]
}
