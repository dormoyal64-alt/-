<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: the journal of original settings belongs to this phone only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
