{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["public/app/js/**/*.js", "public/app/sw.js", "public/app/dev/**/*.js", "public/assets/js/**/*.js"],
  "exclude": ["public/app/vendor/**", "node_modules"]
}
