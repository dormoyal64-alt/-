# Environment for server/index.js (copy to .env or set in your process manager; .env is git-ignored
# and NOT loaded automatically). `npm start` sets NODE_ENV=production and refuses to start on any
# invalid value, listing every problem at once.

# ---- Runtime ---------------------------------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=3000
# HOST=127.0.0.1                # default 127.0.0.1 (dev/test), 0.0.0.0 (production)
# Public origin, no path. REQUIRED in production and must be https. Used for the Origin (CSRF) check,
# payment return/callback URLs and e-mail links. When unset (dev only) the request Host is used.
# PUBLIC_BASE_URL=https://app.example.co.il
DATA_DIR=./data                 # SQLite lives in $DATA_DIR/app.sqlite (':memory:' for throwaway runs)
# REQUIRED in production, >= 32 chars:  openssl rand -base64 48
# SESSION_SECRET=
# SESSION_TTL_DAYS=30           # sliding session lifetime
# TRUST_PROXY=false             # true | false | hop count (1) | "loopback" | CIDR list. Set only behind a proxy you control.
# APP_NAME=VisionApp            # shown in e-mails
# TERMS_VERSION=2026-09-28      # recorded with each registration

# ---- Trial, plans and prices -----------------------------------------------------------------
TRIAL_DAYS=30                   # no card required; one trial per e-mail, ever
CURRENCY=ILS                    # Israeli price list (region IL)
PRICE_MONTHLY=2490              # minor units (agorot), VAT included. Placeholders: change freely.
PRICE_QUARTERLY=5990
PRICE_YEARLY=17990
INTL_CURRENCY=USD               # international price list (region INTL, Paddle)
PRICE_INTL_MONTHLY=599          # must match the prices configured in Paddle
PRICE_INTL_QUARTERLY=1499
PRICE_INTL_YEARLY=4499
# GEO_COUNTRY_HEADER=cf-ipcountry   # optional trusted geo header used when the client sends no country/currency

# ---- Payments --------------------------------------------------------------------------------
# mock (dev/test only, refused in production) | payplus | paddle | auto (IL/ILS -> payplus, others -> paddle)
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=mock-webhook-secret-for-development-only   # x-mock-signature HMAC key (mock only)

# PayPlus (Israel). Required when PAYMENT_PROVIDER is payplus or auto.
# PAYPLUS_ENV=sandbox           # sandbox | production (must be production when NODE_ENV=production)
# PAYPLUS_API_KEY=
# PAYPLUS_SECRET_KEY=           # also the callback HMAC key
# PAYPLUS_PAGE_UID=             # payment page uid for PaymentPages/generateLink
# PAYPLUS_TERMINAL_UID=         # terminal for token charges (monthly renewals, one-tap renew)
# PAYPLUS_API_BASE=             # override; default https://restapidev.payplus.co.il/api/v1.0/ (sandbox) or https://restapi.payplus.co.il/api/v1.0/

# Paddle Billing (international). Required when PAYMENT_PROVIDER is paddle or auto.
# PADDLE_ENV=sandbox            # sandbox | production (must be production when NODE_ENV=production)
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=        # notification destination secret (pdl_ntfset_...)
# PADDLE_WEBHOOK_TOLERANCE_SEC=5
# PADDLE_PRICE_MONTHLY=pri_...
# PADDLE_PRICE_QUARTERLY=pri_...
# PADDLE_PRICE_YEARLY=pri_...
# PADDLE_API_BASE=              # override; default https://sandbox-api.paddle.com or https://api.paddle.com

# ---- Billing rules ---------------------------------------------------------------------------
# PAST_DUE_GRACE_DAYS=7         # access kept after a failed renewal charge (retried every 24 h)
# REFUND_WINDOW_DAYS=14         # cancel {mode:'now'} within this many days of the first charge => full refund
# RENEW_WINDOW_DAYS=30          # fixed-term plans can be renewed from N days before to N days after their end
# MONTHLY_REMINDER_DAYS=3       # e-mail before each Israeli monthly token charge (0 = off)
# RENEWAL_REMINDER_DAYS=7       # final reminder before a fixed term ends / before a Paddle 3-month or yearly renewal
# RENEWAL_INTERVAL_MINUTES=60   # renewal scheduler period (0 = off)

# ---- E-mail ----------------------------------------------------------------------------------
MAIL_PROVIDER=console           # console (logs messages; never logs bodies in production) | http
# MAIL_HTTP_URL=https://mail-relay.example/send   # receives JSON {from,to,subject,text,html,lang,tag}
# MAIL_HTTP_TOKEN=              # sent as Authorization: Bearer <token>
# MAIL_FROM=no-reply@example.co.il

# ---- Testing only ----------------------------------------------------------------------------
# RATE_LIMIT_IP_SCALE=1         # multiplies per-IP limits (default 20 when NODE_ENV=test; fixed at 1 in production)
